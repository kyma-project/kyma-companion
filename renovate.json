{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "schedule": [
    "* 0-2 * * 1",
    "* 0-2 * * 2"
  ],
  "timezone": "Europe/Berlin",
  "includePaths": [
    "pyproject.toml",
    "doc_indexer/pyproject.toml",
    "Dockerfile",
    "doc_indexer/Dockerfile",
    "tests/blackbox/pyproject.toml",
    ".github/workflows/**"
  ],
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScopeDisabled"
  ],
  "enabledManagers": [
    "poetry",
    "github-actions",
    "dockerfile"
  ],
  "packageRules": [
    {
      "matchManagers": ["poetry", "github-actions", "dockerfile"],
      "schedule": ["* 0-2 * * 1"],
      "groupName": "deps: combines dependency bump",
      "addLabels": ["dependencies"]
    },
    {
      "matchManagers": ["poetry"],
      "matchFileNames": ["pyproject.toml"],
      "schedule": ["* 0-2 * * 2"],
      "groupName": null,
      "prTitle": "deps: pyproject.toml",
      "addLabels": ["dependencies"]
    },
    {
      "matchManagers": ["poetry"],
      "matchFileNames": ["doc_indexer/pyproject.toml"],
      "schedule": ["* 0-2 * * 2"],
      "groupName": null,
      "prTitle": "deps: doc_indexer/pyproject.toml",
      "addLabels": ["dependencies"]
    },
    {
      "matchManagers": ["poetry"],
      "matchFileNames": ["tests/blackbox/pyproject.toml"],
      "schedule": ["* 0-2 * * 2"],
      "groupName": null,
      "prTitle": "deps: tests/blackbox/pyproject.toml",
      "addLabels": ["dependencies"]
    },
    {
      "matchManagers": ["github-actions"],
      "schedule": ["* 0-2 * * 2"],
      "groupName": null,
      "prTitle": "deps: .github/workflows",
      "addLabels": ["dependencies"]
    },
    {
      "description": "Both images build from the same wolfi-base digest (the free image has only a latest tag, so these are digest updates); one PR for both files so the digests never diverge.",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Dockerfile", "doc_indexer/Dockerfile"],
      "schedule": ["* 0-2 * * 2"],
      "groupName": "deps: Dockerfiles (wolfi-base digest)",
      "addLabels": ["dependencies"]
    }
  ]
}
